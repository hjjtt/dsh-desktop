+/* The viewer modal's body: the code surface scrolls, status rows center,
+   and the footer's system-open action sits under it. Semantic aliases over
+   --dsw-* tokens only (docs/web-styling.md). */
+
+.body {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  min-height: 0;
+  max-height: min(70vh, 720px);
+}
+
+.status {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 12px 0;
+  font-size: 12px;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+.retry {
+  border: none;
+  background: transparent;
+  padding: 0;
+  font-size: 12px;
+  color: var(--dsw-alias-state-business-primary);
+  cursor: pointer;
+}
+
+.footer {
+  display: flex;
+  justify-content: flex-end;
+}
+
+.openExternal {
+  border: none;
+  background: transparent;
+  padding: 4px 8px;
+  border-radius: 6px;
+  font-size: 12px;
+  color: var(--dsw-alias-label-secondary);
+  cursor: pointer;
+}
+
+.openExternal:hover {
+  color: var(--dsw-alias-label-primary);
+  background: var(--dsw-alias-interactive-bg-hover);
+}
diff --git a/packages/client/ui-deliverables/src/client/FileViewer.tsx b/packages/client/ui-deliverables/src/client/FileViewer.tsx
new file mode 100644
index 0000000000..6ba0c317c1
--- /dev/null
+++ b/packages/client/ui-deliverables/src/client/FileViewer.tsx
@@ -0,0 +1,112 @@
+// FileViewer: the in-app reading surface for one produced file. A chip click
+// opens this modal instead of handing the path to the host's opener; the
+// content arrives through the workspaces readFile wire (the host's
+// complete-result bound cuts oversized files, binary files answer a marker),
+// and the host opener survives as the footer's system-open action.
+
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { FileContent } from '@deepseek-ai/dsh-client-runtime/client'
+import { CodeBlock, Modal } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { DeliverablesKey } from './locales.ts'
+import css from './FileViewer.module.css'
+
+/** The read face the viewer drives; the same workspaces service the file tree uses. */
+export type ReadFileFace = (path: string, signal?: AbortSignal) => Promise<FileContent>
+
+/** Props: the file under view, the read face, the surviving host opener, and the locale seat. */
+export interface FileViewerProps {
+  /** Absolute path of the file to show; undefined renders nothing. */
+  viewing: string | undefined
+  /** Close the viewer. */
+  onClose: () => void
+  /** The workspaces readFile face. */
+  readFile: ReadFileFace
+  /** The host's native opener, offered as the footer's secondary action. */
+  openFile: (path: string) => void
+  /** Whether the host can hand a path to a native desktop application. */
+  canOpenPath: boolean
+  /** Locale seat. */
+  t: (key: DeliverablesKey, params?: Record<string, string>) => string
+}
+
+/** Extension → CodeBlock grammar hint; unknown extensions render plain. */
+const LANG_BY_EXT: Readonly<Record<string, string>> = {
+  ts: 'ts', tsx: 'tsx', mts: 'ts', cts: 'ts', js: 'js', mjs: 'js', cjs: 'js', jsx: 'jsx',
+  json: 'json', css: 'css', scss: 'scss', html: 'html', md: 'md', py: 'python', rs: 'rust',
+  go: 'go', sh: 'sh', bash: 'sh', yml: 'yaml', yaml: 'yaml', toml: 'toml', sql: 'sql',
+}
+
+/** One load's settled shape. */
+interface LoadState {
+  status: 'loading' | 'ready' | 'error'
+  content?: FileContent
+}
+
+/**
+ * Render the produced-file viewer modal.
+ * @param props - the file under view, the read face, and the locale seat.
+ * @returns null when nothing is under view; otherwise the modal.
+ */
+export function FileViewer({ viewing, onClose, readFile, openFile, canOpenPath, t }: FileViewerProps) {
+  const [load, setLoad] = useState<LoadState>({ status: 'loading' })
+  // One abort controller per in-flight load; closing or superseding the view
+  // cancels it so a departed viewer stops the host read.
+  const controller = useRef<AbortController | undefined>(undefined)
+  useEffect(() => () => { controller.current?.abort() }, [])
+
+  const loadFile = useCallback((path: string): void => {
+    controller.current?.abort()
+    const own = new AbortController()
+    controller.current = own
+    setLoad({ status: 'loading' })
+    readFile(path, own.signal).then(
+      (content) => {
+        if (!own.signal.aborted) setLoad({ status: 'ready', content })
+      },
+      () => {
+        if (!own.signal.aborted) setLoad({ status: 'error' })
+      },
+    )
+  }, [readFile])
+
+  useEffect(() => {
+    if (viewing !== undefined) loadFile(viewing)
+    return () => { controller.current?.abort() }
+  }, [viewing, loadFile])
+
+  if (viewing === undefined) return null
+  const name = viewing.split(/[\\/]/).at(-1) ?? viewing
+  const content = load.status === 'ready' ? load.content : undefined
+  return (
+    <Modal open onClose={onClose} title={name} closeLabel={t('viewer.close')} description={viewing} contentClassName={css.body ?? ''}>
+      {load.status === 'loading' && <div className={css.status}>{t('viewer.loading')}</div>}
+      {load.status === 'error' && (
+        <div className={css.status}>
+          {t('viewer.error')}
+          <button type="button" className={css.retry} onClick={() => { loadFile(viewing) }}>{t('viewer.retry')}</button>
+        </div>
+      )}
+      {content !== undefined && content.kind === 'binary' && (
+        <div className={css.status}>{t('viewer.binary')}</div>
+      )}
+      {content !== undefined && content.kind === 'text' && (
+        <>
+          <CodeBlock
+            code={content.content}
+            lang={LANG_BY_EXT[name.split('.').at(-1) ?? ''] ?? undefined}
+            copyLabel={t('viewer.copy')}
+            copiedLabel={t('viewer.copied')}
+          />
+          {content.truncated && <div className={css.status}>{t('viewer.truncated')}</div>}
+        </>
+      )}
+      {canOpenPath && (
+        <div className={css.footer}>
+          <button type="button" className={css.openExternal} onClick={() => { openFile(viewing) }}>
+            {t('viewer.openExternal')}
+          </button>
+        </div>
+      )}
+    </Modal>
+  )
+}
